  {
   "fieldname": "sec_1",
   "fieldtype": "Section Break",
   "label": "Alert Thresholds",
   "collapsible": 0,
   "description": "Configure how many days before/after an event each alert fires. No developer needed."
  },
  {
   "fieldname": "harvest_alert_lead_days",
   "fieldtype": "Int",
   "label": "Harvest / Field Day Alert Lead (Days)",
   "default": "7",
   "description": "Alert promoter & supervisor this many days before expected harvest"
  },
  {
   "fieldname": "unreported_material_days",
   "fieldtype": "Int",
   "label": "Materials Unreported After (Days)",
   "default": "7",
   "description": "Alert if materials received but planting not recorded after this many days"
  },
  {
   "fieldname": "col_2",
   "fieldtype": "Column Break"
  },
